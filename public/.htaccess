DirectoryIndex index.php

<IfModule mod_negotiation.c>
    Options -MultiViews
</IfModule>

<IfModule mod_rewrite.c>
    Options +SymLinksIfOwnerMatch
    RewriteEngine On

    # Configuration des origines CORS autorisées
    RewriteCond %{HTTP:Origin} ^(https?://pro\.testdwm\.fr|https?://app\.testwm\.fr|https?://localhost:3000)$ [NC]
    RewriteRule .* - [E=CORS_ALLOW_ORIGIN:%{HTTP:Origin}]

    # Configuration standard Symfony
    RewriteCond %{REQUEST_URI}::$0 ^(/.+)/(.*)::\2$
    RewriteRule .* - [E=BASE:%1]

    RewriteCond %{HTTP:Authorization} .+
    RewriteRule ^ - [E=HTTP_AUTHORIZATION:%0]

    RewriteCond %{ENV:REDIRECT_STATUS} =""
    RewriteRule ^index\.php(?:/(.*)|$) %{ENV:BASE}/$1 [R=301,L]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ %{ENV:BASE}/index.php [L]
</IfModule>

<IfModule mod_headers.c>
    # Configuration des en-têtes CORS
    # Assurez-vous que seule une valeur est définie pour Access-Control-Allow-Origin
    Header always set Access-Control-Allow-Origin "%{CORS_ALLOW_ORIGIN}e" env=CORS_ALLOW_ORIGIN
    Header always set Access-Control-Allow-Credentials "true" env=CORS_ALLOW_ORIGIN
    Header always set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS" env=CORS_ALLOW_ORIGIN
    Header always set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With" env=CORS_ALLOW_ORIGIN
    Header always set Access-Control-Max-Age "3600" env=CORS_ALLOW_ORIGIN

    # Gestion spéciale pour les requêtes OPTIONS (preflight)
    SetEnvIf Request_Method OPTIONS CORS_PREFLIGHT=1
    Header always set Access-Control-Allow-Origin "%{CORS_ALLOW_ORIGIN}e" env=CORS_PREFLIGHT
    Header always set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS" env=CORS_PREFLIGHT
    Header always set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With" env=CORS_PREFLIGHT
    Header always set Access-Control-Max-Age "3600" env=CORS_PREFLIGHT
    Header always set Access-Control-Allow-Credentials "true" env=CORS_PREFLIGHT
</IfModule>

SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
